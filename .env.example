# Postgres
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla
POSTGRES_PORT=5433

# Backend
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://tesla:tesla@postgres:5432/tesla
# REQUIRED before any real deployment: generate a real random secret, e.g.
# `openssl rand -base64 32` — do not deploy with this placeholder, it is
# public in this repo's history and anyone could forge valid tokens with it.
JWT_SECRET=change-me-in-production
# Restricts which frontend origin may call this API. Defaults to '*' (fine
# for local dev) when unset — set this to your deployed frontend's exact
# origin (e.g. https://your-app.vercel.app) in production.
CORS_ORIGIN=*

# Used by the backend test suite to run migrations against an isolated
# database on the same Postgres server, so tests never touch dev/demo data.
TEST_DATABASE_URL=postgres://tesla:tesla@localhost:5433/tesla_test

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
