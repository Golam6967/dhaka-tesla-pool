{
  "name": "dhaka-tesla-pool-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Dhaka Tesla Pool MVP",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "globalSetup": "./tests/globalSetup.js",
    "setupFiles": [
      "./tests/setupEnv.js"
    ],
    "maxWorkers": 1,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/globalSetup.js",
      "/tests/setupEnv.js",
      "/tests/helpers/"
    ]
  }
}
